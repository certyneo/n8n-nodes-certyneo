{
	"compilerOptions": {
		"strict": true,
		"module": "commonjs",
		"moduleResolution": "node",
		"target": "es2019",
		"lib": ["es2019", "es2020", "es2022.error"],
		"removeComments": true,
		"useUnknownInCatchVariables": false,
		"forceConsistentCasingInFileNames": true,
		"noImplicitAny": true,
		"noImplicitReturns": true,
		"noUnusedLocals": true,
		"strictNullChecks": true,
		"preserveConstEnums": true,
		"esModuleInterop": true,
		"resolveJsonModule": true,
		// Desactive volontairement. `n8n-node build` vide dist/ avant de
		// compiler ; avec incremental, TypeScript se fie a son fichier d'etat et
		// ne reemet que les sources modifiees, produisant un dist/ ampute sans
		// que rien ne le signale. Le paquet 0.1.2 construit ainsi ne contenait
		// que le declencheur. Le build complet prend quelques secondes.
		"incremental": false,
		"declaration": true,
		"sourceMap": true,
		"skipLibCheck": true,
		"outDir": "./dist/"
	},
	"include": ["credentials/**/*", "nodes/**/*", "nodes/**/*.json", "package.json"]
}
